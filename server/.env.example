# Bản demo này chạy in-memory (không cần Postgres), nên KHÔNG cần DATABASE_URL.
# JWT_SECRET không bắt buộc để chạy thử — nếu bỏ trống, server dùng secret dev
# mặc định (xem src/jwt.rs). Trước khi cho ai khác dùng thật, đặt một chuỗi
# ngẫu nhiên dài ở đây.
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien

# Khi nào chuyển sang Postgres thật (xem migrations/schema.sql), thêm lại:
# DATABASE_URL=postgres://postgres:password@localhost:5432/cityquest
