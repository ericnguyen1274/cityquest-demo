# Bản demo này chạy in-memory (không cần Postgres), nên KHÔNG cần DATABASE_URL.
# Chỉ dùng secret dev bên dưới khi chạy thử. Production phải đặt JWT_SECRET riêng
# dài ít nhất 32 ký tự, APP_ENV=production và CORS_ALLOWED_ORIGINS phù hợp.
APP_ENV=development
JWT_SECRET=dev-only-insecure-secret-doi-truoc-khi-deploy
CORS_ALLOWED_ORIGINS=null,http://localhost:8000,http://127.0.0.1:8000

# Khi nào chuyển sang Postgres thật (xem migrations/schema.sql), thêm lại:
# DATABASE_URL=postgres://postgres:password@localhost:5432/cityquest
